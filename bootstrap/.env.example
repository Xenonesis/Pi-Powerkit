# Pi-Powerkit - API Keys
# Copy to ~/.pi/agent/.env and fill in your keys

# AIHubMix (25+ free coding models)
export AIHUBMIX_API_KEY="sk-..."

# Router9 (MiniMax M3 with 1M context)
export ROUTER9_API_KEY="sk-r9k-..."

# Xiaomi MiMo (mimo-v2.5 models)
export XIAOMI_API_KEY="sk-..."

# Databricks GLM-5.2
export DATABRICKS_API_KEY="dapi-..."

# Modal (GLM-5-FP8)
export MODAL_API_KEY="sk-..."

# KiloCode (5 free models)
export KILO_API_KEY="kc_sk_..."

# AgentRouter (Claude Opus 4.8)
export AGENTROUTER_API_KEY="sk-..."

# Cline (11 free models)
export CLINE_API_KEY="sk_..."

# OpenCode Zen (dynamic free model fetcher)
export OPENCODE_API_KEY="sk-..."

# Headroom context compression (optional)
export HEADROOM_API_URL="http://127.0.0.1:8787"
export HEADROOM_API_KEY="sk-..."

# NVIDIA NIM (optional, via OpenRouter)
export NVIDIA_NIM_API_KEY="nvapi-..."
